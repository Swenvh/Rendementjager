{
  "name": "rendementjager-ai-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rendementjager — AI Content Factory voor Nederlandstalige financiële educatie",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run test:integration",
    "test:integration": "vitest run --dir tests",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests",
    "db:migrate": "tsx packages/database/src/cli/migrate.ts",
    "db:seed": "tsx packages/database/src/cli/seed.ts",
    "worker": "tsx apps/worker/src/cli.ts",
    "dev": "npm run dev -w @rj/mission-control",
    "start": "npm run start -w @rj/mission-control",
    "series": "tsx packages/series-engine/src/cli.ts",
    "publish": "tsx apps/worker/src/publish-cli.ts",
    "methods": "tsx packages/research-engine/src/cli.ts",
    "footage": "tsx packages/footage-engine/src/cli.ts",
    "dataset": "tsx packages/video-engine/scripts/dataset.ts",
    "reels:rebuild": "tsx packages/video-engine/scripts/rebuild.ts",
    "ideas": "tsx packages/series-engine/src/ideas-cli.ts",
    "concepts:package": "tsx packages/video-engine/scripts/package-concepts.ts",
    "stories": "tsx packages/video-engine/scripts/stories.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
