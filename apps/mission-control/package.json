{
  "name": "@rj/mission-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mission Control: Hono API (server/) + Vite/React/Tailwind dashboard (src/)",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c green,cyan \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch server/main.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "RJ_SERVE_UI=1 tsx server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "link-first-reel": "tsx server/cli/link-first-reel.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@rj/analytics-engine": "*",
    "@rj/brand": "*",
    "@rj/content-engine": "*",
    "@rj/database": "*",
    "@rj/finance-engine": "*",
    "@rj/integrations": "*",
    "@rj/research-engine": "*",
    "@rj/series-engine": "*",
    "@rj/shared": "*",
    "@rj/voice-engine": "*",
    "@rj/worker": "*",
    "hono": "4.13.12"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
