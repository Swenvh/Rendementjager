# Rendementjager — kopieer naar .env en vul in. .env staat in .gitignore.
# Alle integraties zijn optioneel; zonder key draait het systeem met een
# duidelijk gelabelde lokale fallback.

# Database (lokaal, SQLite)
RJ_DB_PATH=./data/rendementjager.sqlite

# Mission Control
RJ_API_PORT=8787
RJ_UI_PORT=5173

# LLM-provider (optioneel; agents draaien standaard via Claude Code subagents)
ANTHROPIC_API_KEY=

# Voice-over: er is GEEN lokale/robotstem. Zonder ElevenLabs zijn Reels stemloos (ondertitels op leestempo).
# ElevenLabs is een expliciete opt-in: zet RJ_TTS_PROVIDER=elevenlabs EN vul de sleutel en voice-id in.
# RJ_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Achtergrondbeelden (dronebeelden NL). Alleen gelicenseerd materiaal: zie docs/OPERATIONS.md en docs/INTEGRATIONS.md.
# Optioneel, voor `npm run footage -- fetch --provider pexels|pixabay` (officiele API's, niet live getest).
PEXELS_API_KEY=
PIXABAY_API_KEY=
# RJ_FOOTAGE_DIR=./assets/footage   # andere bibliotheeklocatie (standaard assets/footage)

# Publiceren (optioneel, standaard uit)
BUFFER_ACCESS_TOKEN=
N8N_WEBHOOK_URL=

# Kostenlimieten (EUR)
RJ_DAILY_COST_CAP_EUR=5
RJ_MONTHLY_COST_CAP_EUR=50
RJ_PER_JOB_COST_CAP_EUR=1
RJ_MAX_CONCURRENT_JOBS=2
RJ_MAX_RETRIES=3

# Noodstop: zet op 1 om alle verwerking te pauzeren
RJ_EMERGENCY_STOP=0

# --- Publishing (Phase 5). Default: manual packages, no live posting. ---
# RJ_DAILY_PUBLISH_CAP=10
# RJ_PUBLISH_MIN_SPACING_MIN=60
# RJ_PUBLISH_MODE=manual            # or instagram (live adapter, untested; see docs/INTEGRATIONS.md)
# RJ_PUBLIC_MEDIA_BASE_URL=https://media.example.com/reels
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
